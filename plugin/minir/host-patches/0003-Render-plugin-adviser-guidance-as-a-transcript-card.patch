@@ -0,0 +1,39 @@
+import { expect, it } from 'vitest'
+
+import { toChatMessages } from './index'
+
+const BLOCK = [
+  '[adviser — advisory only]',
+  '- [concern · tool_choice · Architecture] re-read the failing test — decide: fix it',
+  '- [nit · general] tidy the helper',
+  '[end adviser]'
+].join('\n')
+
+it('hydrates an adviser row as a system card, not a user prompt', () => {
+  const [message] = toChatMessages([{ role: 'user', content: BLOCK, display_kind: 'adviser', timestamp: 1 }])
+
+  expect(message.role).toBe('system')
+  expect(message.adviser?.severity).toBe('concern')
+  expect(message.adviser?.label).toBe('concern · tool_choice · Architecture')
+  expect(message.adviser?.body).toContain('re-read the failing test')
+  expect(message.adviser?.body).not.toContain('[adviser')
+  expect(message.adviser?.body).not.toContain('[end adviser]')
+  expect(message.adviser?.items).toHaveLength(2)
+})
+
+it('keeps an unparseable adviser row visible instead of dropping it', () => {
+  const [message] = toChatMessages([
+    { role: 'user', content: 'plain advice from an older host', display_kind: 'adviser', timestamp: 2 }
+  ])
+
+  expect(message.role).toBe('system')
+  expect(message.adviser?.severity).toBe('advisory')
+  expect(message.adviser?.body).toBe('plain advice from an older host')
+})
+
+it('leaves a normal user row alone', () => {
+  const [message] = toChatMessages([{ role: 'user', content: 'real prompt', timestamp: 3 }])
+
+  expect(message.role).toBe('user')
+  expect(message.adviser).toBeUndefined()
+})
diff --git a/apps/desktop/src/lib/chat-messages/hydration.ts b/apps/desktop/src/lib/chat-messages/hydration.ts
index 57a7883e26..15998166cb 100644
--- a/apps/desktop/src/lib/chat-messages/hydration.ts
+++ b/apps/desktop/src/lib/chat-messages/hydration.ts
@@ -182,9 +182,37 @@ const NOTICE_DISPLAY_KINDS = [
   'auto_continue',
   'personality_switch',
   // Hermes closing a failed turn, not the model speaking.
-  'failed_turn'
+  'failed_turn',
+  // Plugin adviser guidance: a user-role row the model saw, but not a human prompt.
+  'adviser'
 ] as const
 
+const ADVISER_HEADER_RE = /^\[adviser[^\n]*\]\s*/
+const ADVISER_FOOTER_RE = /\s*\[end adviser\]\s*$/
+const ADVISER_ITEM_RE = /^- \[([^\]]+)\]\s*(.*)$/gm
+
+/** Parse the rendered adviser block into the card's label and body. Display-only. */
+function adviserFromMessage(content: string): ChatMessage['adviser'] | undefined {
+  const raw = String(content || '').trim()
+  if (!raw) {
+    return undefined
+  }
+
+  const body = raw.replace(ADVISER_HEADER_RE, '').replace(ADVISER_FOOTER_RE, '').trim()
+  const items = [...body.matchAll(ADVISER_ITEM_RE)].map(match => {
+    const label = match[1].trim()
+
+    return { label, severity: label.split(' · ')[0]?.trim() || 'advisory', text: match[2].trim() }
+  })
+
+  return {
+    severity: items[0]?.severity ?? 'advisory',
+    label: items[0]?.label ?? 'advisory',
+    body,
+    items
+  }
+}
+
 function isMachineNotice(displayKind: SessionMessage['display_kind']): boolean {
   return displayKind !== undefined && (NOTICE_DISPLAY_KINDS as readonly string[]).includes(displayKind)
 }
@@ -486,6 +514,7 @@ export function toChatMessages(messages: SessionMessage[]): ChatMessage[] {
