 hermes_cli/cli_chat_turn_mixin.py             | 17 ++++++++-
 tests/agent/test_steer.py                     | 10 ++++++
 tests/tui_gateway/test_adviser_trigger_row.py | 35 +++++++++++++++++++
 tui_gateway/prompt_turn.py                    |  9 ++++-
 tui_gateway/session_auto_continue.py          |  4 ++-
 6 files changed, 78 insertions(+), 7 deletions(-)
 create mode 100644 tests/tui_gateway/test_adviser_trigger_row.py

diff --git a/agent/interrupt_control.py b/agent/interrupt_control.py
index 789e41066a..d883d44c1b 100644
--- a/agent/interrupt_control.py
+++ b/agent/interrupt_control.py
@@ -325,14 +325,16 @@ class InterruptControlMixin:
         if not text or not text.strip():
             return False
         cleaned = text.strip()
+        is_adviser = str(kind or "").lower() == "adviser"
         with _ic_lock(self, "_pending_steer_lock"):
             _set_steer_parts(
                 self,
-                _steer_parts(self)
-                + [(ticket, cleaned, "adviser" if str(kind or "").lower() == "adviser" else "user")],
+                _steer_parts(self) + [(ticket, cleaned, "adviser" if is_adviser else "user")],
             )
-        # The turn no longer ran on its own (first-task-done detection reads this off the result).
-        self._turn_user_intervened = True
+        # A reviewer's advice is not a user intervention: first-task-done detection must keep
+        # reading the turn as unattended. Only a human steer clears that flag.
+        if not is_adviser:
+            self._turn_user_intervened = True
         return True
 
     def redirect(self, text: str) -> bool:
diff --git a/hermes_cli/cli_chat_turn_mixin.py b/hermes_cli/cli_chat_turn_mixin.py
index 94d49d3553..28855f77b7 100644
--- a/hermes_cli/cli_chat_turn_mixin.py
+++ b/hermes_cli/cli_chat_turn_mixin.py
@@ -330,6 +330,14 @@ class CLIChatTurnMixin:
         # Notes and voice prefix are API-local: the staged input stays the durable transcript
         # value so a close-path marker follows the same dict instead of a second user row.
         _persist_clean_user_message = message if (turn.voice_prefix or agent_message != message) else None
+        # A leftover adviser trigger re-enters the REPL as a pending input; label its row so
+        # every surface draws a card instead of words the user typed.
+        _display_kind = None
+        _pending_kinds = getattr(self, "_pending_input_kinds", None)
+        if _pending_kinds:
+            _display_kind = _pending_kinds.pop(str(message), None)
+            if _display_kind == "user":
+                _display_kind = None
         _one_turn_model_restore = getattr(self, "_pending_one_turn_model_restore", None)
         self._pending_one_turn_model_restore = None
         try:
@@ -340,7 +348,8 @@ class CLIChatTurnMixin:
                     user_message=agent_message,
                     conversation_history=self.conversation_history[:-1],
                     stream_callback=None if muted else turn.stream_callback, task_id=self.session_id,
-                    persist_user_message=_persist_clean_user_message, moa_config=_moa_cfg,
+                    persist_user_message=_persist_clean_user_message,
+                    persist_user_display_kind=_display_kind, moa_config=_moa_cfg,
                 )
             if getattr(self, "_pending_moa_disable_after_turn", False):
                 _restore = getattr(self, "_pending_moa_restore_model", None) or {}
@@ -595,6 +604,12 @@ class CLIChatTurnMixin:
             preview = _leftover_steer[:60] + ("..." if len(_leftover_steer) > 60 else "")
             _cprint(f"\n{t('cli.chat.delivering_leftover_steer', preview=preview)}")
             self._pending_input.put(_leftover_steer)
+            _kinds = getattr(self, "_pending_input_kinds", None)
+            if _kinds is None:
+                _kinds = self._pending_input_kinds = {}
+            _kinds[str(_leftover_steer)] = ("adviser"
+                                           if (turn.result or {}).get("pending_steer_kind") == "adviser"
+                                           else "user")
 
         return response
 
