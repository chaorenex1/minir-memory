diff --git a/tests/tui_gateway/test_adviser_trigger_row.py b/tests/tui_gateway/test_adviser_trigger_row.py
new file mode 100644
index 0000000000..4ae96103e5
--- /dev/null
+++ b/tests/tui_gateway/test_adviser_trigger_row.py
@@ -0,0 +1,35 @@
+"""A leftover adviser steer becomes the next turn; its row must stay an adviser card."""
+
+from __future__ import annotations
+
+import threading
+
+from tui_gateway import prompt_turn
+
+
+def _run(monkeypatch, result):
+    session = {"history_lock": threading.RLock(), "transport": None}
+    rows: list[tuple[dict, str | None]] = []
+    monkeypatch.setattr(prompt_turn, "_enqueue_prompt", lambda s, t, tr: {"text": t}, raising=False)
+    monkeypatch.setattr(
+        prompt_turn, "_persist_queued_user_row", lambda s, e, k: rows.append((e, k)),
+        raising=False)
+    monkeypatch.setattr(prompt_turn, "_drain_queued_prompt", lambda *a: True, raising=False)
+    prompt_turn._run_post_turn_followups(None, "session-1", session, result, None)
+    return rows
+
+
+def test_leftover_adviser_steer_is_labelled(monkeypatch):
+    rows = _run(monkeypatch, {
+        "pending_steer": "[adviser — advisory only]\n- [concern · reviewer] check it",
+        "pending_steer_kind": "adviser",
+    })
+    assert len(rows) == 1
+    envelope, kind = rows[0]
+    assert kind == "adviser"
+    assert envelope["text"].startswith("[adviser")
+
+
+def test_leftover_human_steer_stays_an_ordinary_turn(monkeypatch):
+    rows = _run(monkeypatch, {"pending_steer": "typed by the user"})
+    assert rows == [({"text": "typed by the user"}, None)]
diff --git a/tui_gateway/prompt_turn.py b/tui_gateway/prompt_turn.py
index 67bf1e3c30..27be0111d6 100644
--- a/tui_gateway/prompt_turn.py
+++ b/tui_gateway/prompt_turn.py
@@ -443,9 +443,16 @@ def _run_post_turn_followups(
     requeued first so it isn't dropped; then goal continuation, then completion
     notifications.  Each nested submit re-checks ``running`` under the lock."""
     steer = result.get("pending_steer") if isinstance(result, dict) else None
+    steer_kind = result.get("pending_steer_kind") if isinstance(result, dict) else None
     if isinstance(steer, str) and steer.strip():
         with session["history_lock"]:
-            _enqueue_prompt(session, steer, session.get("transport"))
+            envelope = _enqueue_prompt(session, steer, session.get("transport"))
+            if envelope is not None:
+                # An adviser trigger is still a real turn, but its row must render as an adviser
+                # card, not as words the user typed. The label rides the queued row into the
+                # drained turn, where ``_run_prompt_submit`` adopts it.
+                _persist_queued_user_row(
+                    session, envelope, "adviser" if steer_kind == "adviser" else None)
     if _drain_queued_prompt(rid, sid, session):
         return
     if goal_followup:
diff --git a/tui_gateway/session_auto_continue.py b/tui_gateway/session_auto_continue.py
index ba20b94d41..7c4b8e0540 100644
--- a/tui_gateway/session_auto_continue.py
+++ b/tui_gateway/session_auto_continue.py
@@ -506,7 +506,9 @@ def _drain_queued_prompt(rid, sid: str, session: dict) -> bool:
     dispatch_failed = False
     try:
         if not use_compute_host:
-            _run_prompt_submit(rid, sid, session, queued["text"], **kwargs, **author_kwargs)
+            _run_prompt_submit(rid, sid, session, queued["text"],
+                               display_kind=queued.get("_queued_display_kind"),
+                               **kwargs, **author_kwargs)
         elif (resp := _submit_prompt_to_compute_host(rid, sid, session, queued["text"], **kwargs)).get("error"):
             with session["history_lock"]:
                 session["running"] = False
