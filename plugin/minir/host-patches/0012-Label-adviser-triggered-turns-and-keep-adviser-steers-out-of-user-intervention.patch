 hermes_cli/cli_chat_turn_mixin.py             |   17 +++++++++++-
 tui_gateway/prompt_turn.py                    |    9 ++++++
 tui_gateway/session_auto_continue.py          |    4 ++-
 tests/agent/test_steer.py                     |   10 +++++++
 tests/tui_gateway/test_adviser_trigger_row.py |   35 +++++++++++++++++++++++++
 6 files changed, 78 insertions(+), 6 deletions(-)

diff --git a/agent/interrupt_control.py b/agent/interrupt_control.py
--- a/agent/interrupt_control.py
+++ b/agent/interrupt_control.py
@@ -275,12 +275,15 @@
         if not text or not text.strip():
             return False
         cleaned = text.strip()
+        is_adviser = str(kind or "").lower() == "adviser"
         with _ic_lock(self, "_pending_steer_lock"):
             existing = _ic_slot(self, "_pending_steer_lock", "_pending_steer")
             self._pending_steer = (existing + "\n" + cleaned) if existing else cleaned
-            self._pending_steer_kind = "adviser" if str(kind or "").lower() == "adviser" else "user"
-        # The turn no longer ran on its own (first-task-done detection reads this off the result).
-        self._turn_user_intervened = True
+            self._pending_steer_kind = "adviser" if is_adviser else "user"
+        # A reviewer's advice is not a user intervention: first-task-done detection must keep
+        # reading the turn as unattended. Only a human steer clears that flag.
+        if not is_adviser:
+            self._turn_user_intervened = True
         return True
 
     def redirect(self, text: str) -> bool:
