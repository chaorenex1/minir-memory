From 0000000000000000000000000000000000000011 Mon Sep 17 00:00:00 2001
From: chaorenex1 <24537608z@gmail.com>
Date: Thu, 22 Oct 2026 13:01:09 +0800
Subject: [PATCH] Color adviser cards by severity in the web inspector

The inspector labelled adviser rows but drew every severity with the muted style and
ignored the note age. Drive the card color from the parsed severity and surface the
turns-ago suffix the adviser block already carries.
---

 web/src/pages/SessionsPage.tsx      |   41 +++++++++++++++++++++++++++++++----
 web/src/pages/SessionsPage.test.tsx |    9 +++++++-
 2 files changed, 44 insertions(+), 6 deletions(-)

diff --git a/web/src/pages/SessionsPage.tsx b/web/src/pages/SessionsPage.tsx
--- a/web/src/pages/SessionsPage.tsx
+++ b/web/src/pages/SessionsPage.tsx
@@ -216,10 +216,11 @@
 const ADVISER_HEADER_RE = /^\[adviser[^\n]*\]\s*/;
 const ADVISER_FOOTER_RE = /\s*\[end adviser\]\s*$/;
 const ADVISER_ITEM_RE = /^- \[([^\]]+)\]\s*(.+)$/gm;
+const ADVISER_TURNS_RE = /\((\d+) turns? ago\)/i;
 
 function splitAdviserContent(
   content: string,
-): { label: string; body: string } | null {
+): { label: string; body: string; severity: string; turnsAgo: number | null } | null {
   const raw = content.trim();
   if (!ADVISER_HEADER_RE.test(raw)) return null;
   const body = raw
@@ -227,9 +228,33 @@
     .replace(ADVISER_FOOTER_RE, "")
     .trim();
   const items = [...body.matchAll(ADVISER_ITEM_RE)];
-  return { label: items[0]?.[1]?.trim() || "advisory", body };
+  const label = items[0]?.[1]?.trim() || "advisory";
+  // The per-note header is `severity · name` (the outer row label adds `adviser · `),
+  // so find the known severity token instead of trusting a fixed position.
+  const severity = label
+    .split(" · ")
+    .map((part) => part.trim().toLowerCase())
+    .find((part) => part in ADVISER_SEVERITY_STYLES) || "advisory";
+  const turns = ADVISER_TURNS_RE.exec(body);
+  return {
+    label,
+    body,
+    severity,
+    turnsAgo: turns ? Number(turns[1]) : null,
+  };
 }
 
+// Severity coloring for an adviser card: the inspector should read the same way the
+// TUI/Desktop cards do (blocker red, concern amber, everything else muted).
+const ADVISER_SEVERITY_STYLES: Record<
+  string,
+  { bg: string; text: string }
+> = {
+  blocker: { bg: "bg-destructive/10", text: "text-destructive" },
+  concern: { bg: "bg-warning/10", text: "text-warning" },
+  nit: { bg: "bg-muted/50", text: "text-muted-foreground" },
+};
+
 
 function MessageBubble({
   msg,
@@ -320,13 +345,19 @@
     msg.display_kind === "adviser" && typeof msg.content === "string"
       ? splitAdviserContent(msg.content)
       : null;
-  const style = adviserSplit
-    ? ROLE_STYLES.adviser
+  const adviserStyle = adviserSplit
+    ? { ...ROLE_STYLES.adviser, ...(ADVISER_SEVERITY_STYLES[adviserSplit.severity] ?? {}) }
+    : null;
+  const style = adviserStyle
+    ? adviserStyle
     : isCompaction
       ? ROLE_STYLES.compaction
       : ROLE_STYLES[msg.role] ?? ROLE_STYLES.system;
   const label = adviserSplit
-    ? `${ROLE_STYLES.adviser.label} · ${adviserSplit.label}`
+    ? `${ROLE_STYLES.adviser.label} · ${adviserSplit.label}` +
+      (adviserSplit.turnsAgo != null
+        ? ` · ${adviserSplit.turnsAgo} ${adviserSplit.turnsAgo === 1 ? "turn" : "turns"} ago`
+        : "")
     : isCompaction
       ? ROLE_STYLES.compaction.label
       : msg.tool_name
diff --git a/web/src/pages/SessionsPage.test.tsx b/web/src/pages/SessionsPage.test.tsx
--- a/web/src/pages/SessionsPage.test.tsx
+++ b/web/src/pages/SessionsPage.test.tsx
@@ -270,7 +270,7 @@
           role: "user",
           display_kind: "adviser",
           content:
-            "[adviser — advisory only]\n- [blocker · reviewer] Stop: the migration drops the index.\n[end adviser]",
+            "[adviser — advisory only]\n- [blocker · reviewer] Stop: the migration drops the index. (1 turn ago)\n[end adviser]",
         },
       ],
     });
@@ -284,9 +284,16 @@
 
     const text = document.body.textContent ?? "";
     expect(text).toContain("adviser · blocker · reviewer");
+    expect(text).toContain("adviser · blocker · reviewer · 1 turn ago");
     expect(text).toContain("Stop: the migration drops the index.");
     expect(text).not.toContain("[adviser — advisory only]");
     expect(text).not.toContain("[end adviser]");
+    // The severity drives the card color, the same way the TUI/Desktop cards read.
+    const cardLabel = Array.from(document.querySelectorAll("span")).find(
+      (span) => span.textContent?.trim() === "adviser · blocker · reviewer · 1 turn ago",
+    );
+    expect(cardLabel).toBeTruthy();
+    expect(cardLabel!.closest('[class*="bg-destructive"]')).not.toBeNull();
     // Only the real prompt wears the User label.
     const userLabels = Array.from(document.querySelectorAll("span")).filter(
       (span) => span.textContent?.trim() === "User",
