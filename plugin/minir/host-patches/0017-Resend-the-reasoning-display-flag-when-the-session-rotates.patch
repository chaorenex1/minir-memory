From 950c96f739a48b8f629959afb32f9995bafb7ba8 Mon Sep 17 00:00:00 2001
From: chaorenex1 <24537608z@gmail.com>
Date: Tue, 27 Oct 2026 23:48:46 +0800
Subject: [PATCH] 0017 Resend the reasoning display flag when the session
 rotates

---
 hermes_cli/gateway_agent.py | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/hermes_cli/gateway_agent.py b/hermes_cli/gateway_agent.py
index 2674770230..10259560c5 100644
--- a/hermes_cli/gateway_agent.py
+++ b/hermes_cli/gateway_agent.py
@@ -406,6 +406,11 @@ class GatewayAgent:
         self._apply_info(state.info)
         if state.usage:
             self.apply_session_usage(state.usage)
+        # The rotated id is a different gateway session whose display flag starts unset — and unset
+        # resolves to OFF for a CLI launch (gateway.local_viewer_events.launch_shows_reasoning), so
+        # /new, /resume and /branch would silently stop the reasoning stream. The sink setter memoises
+        # per session id: re-assigning it is what carries the flag onto the session just entered.
+        self.reasoning_callback = getattr(self, "_reasoning_callback", None)
 
     # -- reasoning display -------------------------------------------------------------------
     @property
-- 
2.53.0.windows.3

