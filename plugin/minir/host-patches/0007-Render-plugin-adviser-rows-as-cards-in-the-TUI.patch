-        # now instead of waiting for the next transcript hydrate.
-        "plugin_message_callback": lambda row: _emit(
-            "message.adviser", sid, _adviser_payload(dict(row)))}
+        # now instead of waiting for the next transcript hydrate. A plain mid-turn steer is a
