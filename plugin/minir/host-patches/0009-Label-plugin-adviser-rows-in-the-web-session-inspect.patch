+describe("adviser transcript rows", () => {
+  it("labels plugin adviser guidance as adviser, never as a user turn", async () => {
+    apiMocks.getSessionMessages.mockResolvedValue({
+      session_id: "sid-adviser",
+      messages: [
+        { role: "user", content: "run the migration" },
+        {
+          role: "user",
+          display_kind: "adviser",
+          content:
+            "[adviser — advisory only]\n- [blocker · reviewer] Stop: the migration drops the index.\n[end adviser]",
+        },
+      ],
+    });
+    await renderSessionsPage([
+      { id: "sid-adviser", profile: "default", source: "cli", model: null, title: "Advised", started_at: 1,
+        ended_at: null, last_active: 1, is_active: false, message_count: 2, tool_call_count: 0,
+        input_tokens: 1, output_tokens: 1, preview: "run" },
+    ]);
+    await act(async () => click(button("Delete session")!.closest("div.cursor-pointer")));
+    await waitFor(() => (document.body.textContent ?? "").includes("drops the index"));
+
+    const text = document.body.textContent ?? "";
+    expect(text).toContain("adviser · blocker · reviewer");
+    expect(text).toContain("Stop: the migration drops the index.");
+    expect(text).not.toContain("[adviser — advisory only]");
+    expect(text).not.toContain("[end adviser]");
+    // Only the real prompt wears the User label.
+    const userLabels = Array.from(document.querySelectorAll("span")).filter(
+      (span) => span.textContent?.trim() === "User",
+    );
+    expect(userLabels).toHaveLength(1);
+  });
+});
diff --git a/web/src/pages/SessionsPage.tsx b/web/src/pages/SessionsPage.tsx
index b391f1ccb0..ef00f0acbe 100644
--- a/web/src/pages/SessionsPage.tsx
+++ b/web/src/pages/SessionsPage.tsx
@@ -210,6 +210,26 @@ function splitCompactionContent(content: string): CompactionSplit | null {
   };
 }
 
+// A plugin adviser row persists as user-role content with ``display_kind="adviser"``:
+// model-facing guidance, never a human prompt. Its bracketed header/footer are machine
+// chrome, so the inspector shows the severity label + advice body instead.
+const ADVISER_HEADER_RE = /^\[adviser[^\n]*\]\s*/;
+const ADVISER_FOOTER_RE = /\s*\[end adviser\]\s*$/;
+const ADVISER_ITEM_RE = /^- \[([^\]]+)\]\s*(.+)$/gm;
+
+function splitAdviserContent(
+  content: string,
+): { label: string; body: string } | null {
+  const raw = content.trim();
+  if (!ADVISER_HEADER_RE.test(raw)) return null;
+  const body = raw
+    .replace(ADVISER_HEADER_RE, "")
+    .replace(ADVISER_FOOTER_RE, "")
+    .trim();
+  const items = [...body.matchAll(ADVISER_ITEM_RE)];
+  return { label: items[0]?.[1]?.trim() || "advisory", body };
+}
+
 
 function MessageBubble({
   msg,
@@ -252,6 +272,12 @@ function MessageBubble({
       text: "text-muted-foreground italic",
       label: "Context handoff",
     },
+    // Plugin adviser guidance: model-facing, so it must never read as a user turn.
+    adviser: {
+      bg: "bg-muted/50",
+      text: "text-muted-foreground",
+      label: "adviser",
+    },
   };
 
   // When a compaction handoff is merged into the front of the first
@@ -290,14 +316,22 @@ function MessageBubble({
   }
 
   const isCompaction = compactionSplit !== null;
-  const style = isCompaction
-    ? ROLE_STYLES.compaction
-    : ROLE_STYLES[msg.role] ?? ROLE_STYLES.system;
-  const label = isCompaction
-    ? ROLE_STYLES.compaction.label
-    : msg.tool_name
-      ? `${t.sessions.roles.tool}: ${msg.tool_name}`
-      : style.label;
+  const adviserSplit =
+    msg.display_kind === "adviser" && typeof msg.content === "string"
+      ? splitAdviserContent(msg.content)
+      : null;
+  const style = adviserSplit
+    ? ROLE_STYLES.adviser
+    : isCompaction
+      ? ROLE_STYLES.compaction
+      : ROLE_STYLES[msg.role] ?? ROLE_STYLES.system;
+  const label = adviserSplit
+    ? `${ROLE_STYLES.adviser.label} · ${adviserSplit.label}`
+    : isCompaction
+      ? ROLE_STYLES.compaction.label
+      : msg.tool_name
+        ? `${t.sessions.roles.tool}: ${msg.tool_name}`
+        : style.label;
 
   // Check if any search term appears as a prefix of any word in content
   const isHit = (() => {
@@ -329,7 +363,13 @@ function MessageBubble({
           </span>
         )}
       </div>
-      {msg.content &&
+      {adviserSplit && (
