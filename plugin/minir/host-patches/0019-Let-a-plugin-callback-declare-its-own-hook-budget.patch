From 6fa97502a22ee7a34b480bfb999ebc0c6992b9e1 Mon Sep 17 00:00:00 2001
From: chaorenex1 <24537608z@gmail.com>
Date: Wed, 28 Oct 2026 03:25:22 +0800
Subject: [PATCH] 0019 Let a plugin callback declare its own hook budget

``plugins.hook_callback_timeout`` is one value for every bounded hook, and it is
fail-closed for ``pre_tool_call``. A plugin whose pre-tool gate has to consult a model
(a merge gate) then has no way to ask for more time without also handing 120 s to every
result transform and LLM observer in the process.

A callback may now carry ``__hook_timeout__``; the dispatcher reads it once per call,
clamps it to the same 600 s ceiling, and keeps the global value for everything else. The
threaded path itself still follows the global timeout, so ``hook_callback_timeout: 0``
keeps the synchronous call: a declaration lengthens one budget, it never re-enables a
worker.

This is a host-level capability, not a private hook for one plugin. Unlisted callbacks
keep the 30 s default; a malformed or non-positive value is ignored.
---
 hermes_cli/plugins_dispatch.py                  |   27 +++++++
 tests/hermes_cli/test_plugin_callback_budget.py |   90 +++++++++++++++++++++++
 2 files changed, 116 insertions(+), 1 deletion(-)

diff --git a/hermes_cli/plugins_dispatch.py b/hermes_cli/plugins_dispatch.py
index accb9c5ddc..ed40f57631 100644
--- a/hermes_cli/plugins_dispatch.py
+++ b/hermes_cli/plugins_dispatch.py
@@ -66,6 +66,27 @@ _HOOK_TIMEOUT_SUPPRESSION_SECONDS = 60.0
 _HOOK_MAX_ABANDONED_WORKERS = 3
 _PRE_TOOL_CALL_TIMEOUT_BLOCK_MESSAGE = "pre_tool_call plugin callback timed out or is still running"
 
+#: A callback may declare its own wall-clock budget instead of the global
+#: ``plugins.hook_callback_timeout``: a ``pre_tool_call`` gate that consults a model needs more
+#: than the default 30 s, while every other callback must keep it. Read once per call and clamped
+#: to the same ceiling; an undeclared or malformed attribute changes nothing.
+_CALLBACK_TIMEOUT_ATTR = "__hook_timeout__"
+
+
+def _callback_budget(cb: Callable, default: float) -> float:
+    """The budget for one callback: its declared ``__hook_timeout__``, or *default*."""
+    declared = getattr(cb, _CALLBACK_TIMEOUT_ATTR, None)
+    if declared is None:
+        return default
+    try:
+        value = float(declared)
+    except (TypeError, ValueError):
+        return default
+    if value <= 0:
+        return default
+    return min(value, _MAX_HOOK_CALLBACK_TIMEOUT_SECS)
+
+
 
 def _policy_error_block_directive(hook_name: str, cb: Callable, exc: BaseException) -> dict[str, str]:
     """Block directive for a fail-closed hook whose callback raised: names the callback and the
@@ -278,7 +299,11 @@ class PluginDispatchMixin:
         for cb in self._hooks.get(hook_name, []):
             try:
                 if use_timeout:
-                    ret = self._run_hook_callback_bounded(hook_name, cb, kwargs, timeout)
+                    # A callback may carry its own budget (``__hook_timeout__``); the global
+                    # value is the default, not the ceiling. The threaded path itself is still
+                    # gated on the global timeout above.
+                    ret = self._run_hook_callback_bounded(
+                        hook_name, cb, kwargs, _callback_budget(cb, timeout))
                     if ret is _HOOK_SKIPPED:
                         if fail_closed:  # policy hook: fail closed with a block directive
                             results.append({"action": "block", "message": _PRE_TOOL_CALL_TIMEOUT_BLOCK_MESSAGE})
diff --git a/tests/hermes_cli/test_plugin_callback_budget.py b/tests/hermes_cli/test_plugin_callback_budget.py
new file mode 100644
index 0000000000..cd6b11a688
--- /dev/null
+++ b/tests/hermes_cli/test_plugin_callback_budget.py
@@ -0,0 +1,90 @@
+"""A plugin callback may declare its own hook budget (``__hook_timeout__``).
+
+``plugins.hook_callback_timeout`` is one value for every bounded hook. A ``pre_tool_call`` gate
+that asks a model for a go/no-go needs more than the default 30 s, while a result transform must
+keep it. The declaration extends that one callback; the threaded path itself still follows the
+global value, so ``hook_callback_timeout: 0`` keeps the synchronous call and no plugin can
+re-enable the worker on its own.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+
+from hermes_cli.plugins import PluginManager
+
+
+def test_a_callback_without_a_declaration_keeps_the_global_budget(monkeypatch):
+    """The same callback, no declaration: the global 0.2 s still abandons it."""
+    monkeypatch.setattr("hermes_cli.plugins._resolve_hook_callback_timeout", lambda: 0.2)
+    hold = threading.Event()
+
+    def slow(**_kwargs):
+        hold.wait(1.0)
+        return {"late": True}
+
+    manager = PluginManager()
+    manager._hooks["post_tool_call"] = [slow]
+
+    started = time.monotonic()
+    try:
+        assert manager.invoke_hook("post_tool_call") == []
+        assert time.monotonic() - started < 1.0
+    finally:
+        hold.set()
+
+
+def test_a_declared_budget_overrides_the_global_value(monkeypatch):
+    """1 s of work survives a 0.2 s global budget because the callback declared 3 s."""
+    monkeypatch.setattr("hermes_cli.plugins._resolve_hook_callback_timeout", lambda: 0.2)
+    hold = threading.Event()
+
+    def slow(**_kwargs):
+        hold.wait(1.0)
+        return {"ok": True}
+
+    slow.__hook_timeout__ = 3
+    manager = PluginManager()
+    manager._hooks["post_tool_call"] = [slow]
+
+    try:
+        assert manager.invoke_hook("post_tool_call") == [{"ok": True}]
+    finally:
+        hold.set()
+
+
+def test_an_undeclared_hook_still_fails_closed_under_the_global_budget(monkeypatch):
+    """``pre_tool_call`` keeps its veto: a declared budget cannot turn a timeout into a pass."""
+    monkeypatch.setattr("hermes_cli.plugins._resolve_hook_callback_timeout", lambda: 0.2)
+    hold = threading.Event()
+
+    def slow(**_kwargs):
+        hold.wait(1.0)
+        return None
+
+    manager = PluginManager()
+    manager._hooks["pre_tool_call"] = [slow]
+
+    try:
+        results = manager.invoke_hook("pre_tool_call", tool_name="write_file", args={})
+    finally:
+        hold.set()
+    assert results and results[0]["action"] == "block"
+
+
+def test_the_budget_is_clamped_and_malformed_values_are_ignored():
+    from hermes_cli import plugins_dispatch
+
+    def callback(**_kwargs):
+        return None
+
+    assert plugins_dispatch._callback_budget(callback, 30.0) == 30.0
+    callback.__hook_timeout__ = 120
+    assert plugins_dispatch._callback_budget(callback, 30.0) == 120.0
+    callback.__hook_timeout__ = 10_000
+    assert (plugins_dispatch._callback_budget(callback, 30.0)
+            == plugins_dispatch._MAX_HOOK_CALLBACK_TIMEOUT_SECS)
+    for bad in (0, -1, "soon", None, object()):
+        callback.__hook_timeout__ = bad
+        assert plugins_dispatch._callback_budget(callback, 30.0) == 30.0
