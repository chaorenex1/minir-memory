 from agent.error_classifier import FailoverReason, classify_api_error
 from agent.micro_compaction import MicroCompactionMixin
-from agent.prompt_builder import STEER_DISPLAY_KIND
+from agent.prompt_builder import ADVISER_DISPLAY_KIND, STEER_DISPLAY_KIND
 from agent.model_metadata import (
     CHARS_PER_TOKEN, MINIMUM_CONTEXT_LENGTH, get_model_context_length, estimate_messages_tokens_rough, estimate_tokens_rough,
     strip_opaque_replay_items,
@@ -1336,11 +1336,11 @@ def _last_assistant_index(messages: list[dict[str, Any]]) -> int:
 
 def _pending_tool_round(messages: list[dict[str, Any]]) -> range:
     """Indices of the tool results the transcript ends with — a round the model has not answered yet; empty when
-    the transcript ends in any other row. /steer rows after the round do not answer it: a steer is delivered
-    after the newest tool result before the next API call, and two can land in one iteration (one when the tool
-    batch ends, one before the request), so every contiguous trailing steer row is skipped."""
+    the transcript ends in any other row. /steer and adviser rows after the round do not answer it: a steer is
+    delivered after the newest tool result before the next API call, and two can land in one iteration (one when
+    the tool batch ends, one before the request), so every contiguous trailing steer/adviser row is skipped."""
     end = len(messages)
-    while end and messages[end - 1].get("display_kind") == STEER_DISPLAY_KIND:
+    while end and messages[end - 1].get("display_kind") in (STEER_DISPLAY_KIND, ADVISER_DISPLAY_KIND):
         end -= 1
     start = end
     while start > 0 and messages[start - 1].get("role") == "tool":
diff --git a/tests/agent/test_steer.py b/tests/agent/test_steer.py
index 95ff222dbd..5925d8ba69 100644
--- a/tests/agent/test_steer.py
+++ b/tests/agent/test_steer.py
@@ -489,6 +489,36 @@ class TestSteerInjection:
         assert [m["role"] for m in merged] == ["user", "user"]
         assert merged[-1]["content"] == "next question"
 
+    def test_persisted_adviser_row_is_never_merged_with_the_next_prompt(self):
+        """An adviser row is user-shaped for the provider, but the user did not write it.
+
+        Round-tripping it through the alternation repair would rewrite a persisted row with the
+        user's next prompt and leave the transcript claiming the user said it.
+        """
+        from agent.agent_runtime_helpers import _merge_consecutive_users
+        from agent.prompt_builder import advisory_user_row
+
+        adviser = advisory_user_row("[adviser — advisory only]\n- [concern] re-read the diff\n[end adviser]")
+        before = dict(adviser)
+        merged, repairs = _merge_consecutive_users([adviser, {"role": "user", "content": "next question"}])
+        assert adviser == before
+        assert repairs == 0
+        assert [m["role"] for m in merged] == ["user", "user"]
+        assert merged[-1]["content"] == "next question"
+
+    def test_trailing_adviser_row_does_not_hide_the_pending_tool_round(self):
+        """The advice lands right after the newest tool result; a round with no answer must still
+        be found or compaction pairs the tool row with the advice instead of the model's reply."""
+        from agent.context_compressor import _pending_tool_round
+
+        messages = [
+            {"role": "assistant", "content": "", "tool_calls": []},
+            {"role": "tool", "content": "ok", "tool_call_id": "a"},
+            {"role": "user", "content": "[adviser — advisory only]\n- [concern] x\n[end adviser]",
+             "display_kind": "adviser"},
+        ]
+        assert list(_pending_tool_round(messages)) == [1]
+
     def test_multimodal_tool_content_untouched_steer_lands_as_user_row(self):
         """Anthropic-style list content on tool results is left untouched —
         the steer is appended as a standalone user message instead of being
