From 5e2514d16de789d819a6753aa7ac039d3e99dbdc Mon Sep 17 00:00:00 2001
From: chaorenex1 <24537608z@gmail.com>
Date: Thu, 22 Oct 2026 04:13:58 +0800
Subject: [PATCH] Keep adviser rows out of user-turn merging and tool-round
 detection

An adviser row is user-shaped for the provider but not written by the user. The
alternation repair would merge the next prompt into the persisted row, and the
pending-tool-round scan would stop at a trailing adviser row and lose the round.
Treat display_kind=adviser like the /steer row in both places; the row stays
byte-identical and compaction still pairs the tool result with the model reply.
---
 agent/agent_runtime_helpers.py |  7 ++++---
 agent/context_compressor.py    | 10 +++++-----
 tests/agent/test_steer.py      | 30 ++++++++++++++++++++++++++++++
 3 files changed, 39 insertions(+), 8 deletions(-)

diff --git a/agent/agent_runtime_helpers.py b/agent/agent_runtime_helpers.py
index 6e463920ad..d2b32d9d87 100644
--- a/agent/agent_runtime_helpers.py
+++ b/agent/agent_runtime_helpers.py
@@ -21,7 +21,7 @@ from agent.message_sanitization import (
 )
 from agent.message_metadata import (
     TOOL_CALL_UIDS, merge_tool_call_uids, per_occurrence_tool_call_uids, record_absorbed_message)
-from agent.prompt_builder import STEER_DISPLAY_KIND, steer_row
+from agent.prompt_builder import ADVISER_DISPLAY_KIND, STEER_DISPLAY_KIND, steer_row
 from agent.tool_dispatch_helpers import _trajectory_normalize_msg, make_tool_result_message
 from agent.think_scrubber import THINK_TAG_NAMES
 from agent.trajectory import convert_scratchpad_to_think
@@ -680,8 +680,9 @@ def _merge_consecutive_users(messages: list[dict]) -> tuple[list[dict], int]:
             # retry/rewind; never mutate the persisted carrier (sanitizers merge copies later).
             and split_user_originated_turn(prev)[0] is None
             # A /steer row that ended the previous run is already persisted; merging the next
-            # prompt into it would rewrite it in place and re-break replay parity.
-            and prev.get("display_kind") != STEER_DISPLAY_KIND
+            # prompt into it would rewrite it in place and re-break replay parity. Same for an
+            # adviser row: it is user-shaped for the provider, but not the user speaking.
+            and prev.get("display_kind") not in (STEER_DISPLAY_KIND, ADVISER_DISPLAY_KIND)
             # Only merge plain-text content; leave multimodal (list or undecodable sentinel) content alone.
             and _plain_text(prev.get("content", "")) and _plain_text(msg.get("content", ""))
         ):
