+    agent._current_turn_id = "turn-2"
+    assert plugin_runtime.turn_state("session-1")["turn_id"] == "turn-2"
+    plugin_runtime.unbind_turn(agent)
+    assert plugin_runtime.live_turn("session-1") is False
