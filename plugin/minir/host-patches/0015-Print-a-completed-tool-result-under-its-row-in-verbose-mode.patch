 import importlib
 from unittest.mock import MagicMock, patch
 
+import pytest
+
 
 # Module-level reference to the cli module (set by _make_cli on first call)
 _cli_mod = None
@@ -139,6 +141,76 @@ class TestToolProgressScrollback:
